PORT=4000
JWT_SECRET=replace-with-a-long-random-string
# Local dev example: postgres://postgres:postgres@localhost:5432/nexahr
# Render: paste the "External Database URL" (or "Internal Database URL" if backend is also on Render) from your Render Postgres instance
DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional: creates YOUR OWN personal Super Admin account the first time the server
# boots with these set. Never commit real values here — only set them in Render's
# Environment tab (or your local .env, which is gitignored). Safe to leave set
# permanently; this only creates the account once.
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
